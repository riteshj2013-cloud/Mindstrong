# Copy to .env.local for local builds. For GitHub Pages, set these as
# Actions secrets / vars and pass into `next build` — never commit real values.
#
# Auth: when all four required Firebase keys are set, the app uses Firebase
# (Google popup + email link/password). Otherwise local demo login.

NEXT_PUBLIC_BASE_PATH=/Mindstrong

# NEXT_PUBLIC_AUTH_PROVIDER=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Payments (publishable key only — secret stays on serverless):
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
